      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "section": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "navigation": {
      "$value": {
        "value": 7,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "table": {
      "$value": {
        "value": 9,
        "unit": "px"
      }
    },
