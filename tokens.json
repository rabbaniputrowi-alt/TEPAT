        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans, Segoe UI, sans-serif",
        "fontSize": {
          "value": 1.7,
          "unit": "rem"
