  "typography": {
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans, Segoe UI, sans-serif",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 760,
        "letterSpacing": {
          "value": -0.035,
          "unit": "em"
        }
      }
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans, Segoe UI, sans-serif",
        "fontSize": {
          "value": 1.1,
          "unit": "rem"
